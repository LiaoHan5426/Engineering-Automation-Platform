# Copy to py-backend/.env (gitignored). Keys stay on this machine only.

# Absolute or relative data root; SQLite lives under <root>/.eap/db/eap.sqlite
EAP_DATA_ROOT=

# Optional workspace cwd for argv tools (git status). Defaults to repo parent of py-backend.
EAP_WORKSPACE_ROOT=

# OpenAI-compatible model endpoint (DeepSeek / OpenAI / local gateway)
EAP_MODEL_BASE_URL=https://api.deepseek.com/v1
EAP_MODEL_API_KEY=
EAP_MODEL_DEFAULT=deepseek-chat

# Bind address — loopback only for the thin MVP
EAP_HOST=127.0.0.1
EAP_PORT=8080
# Hot reload when running `python main.py` (default true). Set false to disable.
EAP_RELOAD=true
