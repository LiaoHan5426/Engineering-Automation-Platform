{
  "apiVersion": "eap/v1",
  "kind": "Expert",
  "id": "sql-expert",
  "name": "SQL Expert",
  "knowledgeBases": [],
  "steps": [
    {"id": "parse", "label": "解析 SQL", "capability": "sql.parse", "required": true},
    {"id": "knowledge", "label": "检索优化知识", "capability": "knowledge.search", "required": true},
    {"id": "schema", "label": "读取授权表结构", "capability": "database.schema.read", "required": false},
    {"id": "indexes", "label": "检查索引", "capability": "database.index.read", "required": false},
    {"id": "explain", "label": "分析执行计划", "capability": "database.explain", "required": false}
  ],
  "edges": [
    {"source": "parse", "target": "knowledge"},
    {"source": "knowledge", "target": "schema"},
    {"source": "schema", "target": "indexes"},
    {"source": "indexes", "target": "explain"}
  ],
  "capabilities": ["sql.parse", "knowledge.search", "database.schema.read", "database.index.read", "database.explain"],
  "rules": ["database.credentials.never-expose", "candidate-sql.must-preserve-semantics"],
  "escalation": { "provider": "local-model", "when": "confidence < 0.75" }
}
