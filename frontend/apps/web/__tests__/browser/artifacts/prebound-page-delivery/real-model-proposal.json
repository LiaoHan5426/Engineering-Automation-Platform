      "content": "<script setup lang=\"ts\">\nimport { Badge, Collapse } from '@eap/ui'\nimport type { CodeGenerationSnapshot } from '@eap/runtime-client'\nimport { useI18n } from 'vue-i18n'\ndefineProps<{ generation?: CodeGenerationSnapshot | null }>()\nconst { t } = useI18n()\n</script>\n<template>\n  <Collapse v-if=\"generation\" data-testid=\"generation-record\">\n    <template #summary>\n      {{ t('generation.title') }} · {{ generation.targetPath }}\n      <Badge v-if=\"generation.taskBinding\" data-testid=\"generation-prebound\">\n        {{ t('generation.prebound') }}\n      </Badge>\n    </template>\n    <div class=\"generation-baseline\">\n      <code>{{ generation.id }}</code>\n      <p>{{ t('generation.target') }}：{{ generation.targetPath }}</p>\n      <p v-if=\"generation.baseHash === 'absent'\">{{ t('generation.absent') }}</p>\n      <p v-else>\n        SHA-256：<code>{{ generation.baseHash }}</code>\n      </p>\n      <p>{{ t('generation.captured') }}：{{ generation.capturedAt }}</p>\n      <p v-if=\"generation.taskBinding\">\n        {{ t('generation.taskBinding') }}：{{ generation.taskBinding.projectId }} ·\n        {{ generation.taskBinding.taskId }} · r{{ generation.taskBinding.revision }}\n      </p>\n      <p v-if=\"generation.prototypeVersionId\">\n        {{ t('generation.prototype') }}：<code\n          >{{ generation.prototypeVersionId }} · {{ generation.prototypeContentHash }}</code\n        >\n      </p>\n      <p>{{ t('generation.boundary') }}</p>\n      <p v-if=\"generation.taskBinding\" data-testid=\"generation-next-step\">\n        {{ t('generation.deliveryNext') }}\n      </p>\n    </div>\n  </Collapse>\n  <p v-else class=\"hint\" data-testid=\"generation-missing\">{{ t('generation.missing') }}</p>\n</template>\n<style scoped>\n.generation-baseline {\n  display: grid;\n  gap: 8px;\n  min-width: 0;\n}\n.generation-baseline p,\n.generation-baseline code {\n  overflow-wrap: anywhere;\n}\n.generation-baseline code {\n  font-size: 11px;\n}\n</style>\n",
