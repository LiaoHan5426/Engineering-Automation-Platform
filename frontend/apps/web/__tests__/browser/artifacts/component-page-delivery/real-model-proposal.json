      "before": "export type EvidenceFile = {\n  path: string\n  before: string | null\n  content: string\n  baseHash: string\n}\nexport function evidenceRows(files: EvidenceFile[], query: string) {\n  return files.filter((file) => file.path.toLowerCase().includes(query.toLowerCase()))\n}\n",
      "content": "export type EvidenceFile = {\n  path: string\n  before: string | null\n  content: string\n  baseHash: string\n}\n\nexport function evidenceRows(files: EvidenceFile[], query: string): EvidenceFile[] {\n  const normalizedQuery = query.toLowerCase()\n  return files.filter((file) => file.path.toLowerCase().includes(normalizedQuery))\n}\n",
