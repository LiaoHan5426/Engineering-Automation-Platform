      "content": "<script setup lang=\"ts\">\nimport { Badge } from '@eap/ui'\n\ndefineProps<{\n  total: number\n  changed: number\n  added: number\n  status: string\n  labels: Record<string, string>\n}>()\n</script>\n\n<template>\n  <div data-testid=\"evidence-summary\" class=\"evidence-summary\">\n    <Badge>{{ status }}</Badge>\n    <dl>\n      <div><dt>{{ labels.total }}</dt><dd data-testid=\"evidence-total\">{{ total }}</dd></div>\n      <div><dt>{{ labels.changed }}</dt><dd data-testid=\"evidence-changed\">{{ changed }}</dd></div>\n      <div><dt>{{ labels.added }}</dt><dd data-testid=\"evidence-added\">{{ added }}</dd></div>\n    </dl>\n  </div>\n</template>\n\n<style scoped>\n.evidence-summary, dl, dl > div {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: var(--spacing-2, 0.5rem);\n}\n.evidence-summary, dl {\n  gap: var(--spacing-4, 1rem);\n}\ndl, dd {\n  margin: 0;\n}\n</style>\n",
