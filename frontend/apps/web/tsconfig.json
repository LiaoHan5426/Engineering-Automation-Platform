{
  "extends": "@eap/tsconfig/base.json",
  "compilerOptions": {
    "types": [
      "vite/client"
    ],
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.types",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo"
  },
  "references": [
    {
      "path": "../../packages/style"
    },
    {
      "path": "../../packages/ui"
    }
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}