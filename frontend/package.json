{
  "name": "engineering-automation-platform-frontend",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "internal/*"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "vue-tsc --build",
    "check:boundaries": "node scripts/check-boundaries.ts",
    "dev": "vp dev",
    "build": "vp build",
    "check": "vp check",
    "test": "vp test",
    "preview": "vp preview",
    "stylelint": "stylelint \"**/*.{css,vue}\"",
    "stylelint:fix": "stylelint \"**/*.{css,vue}\" --fix",
    "clean": "node ./scripts/clean.mjs"
  },
  "devDependencies": {
    "@eap/stylelint-config": "workspace:*",
    "@eap/tsconfig": "workspace:*",
    "@tailwindcss/vite": "catalog:frontend",
    "@types/node": "catalog:types",
    "@vitejs/plugin-vue": "catalog:tooling",
    "postcss-html": "catalog:style",
    "stylelint": "catalog:style",
    "stylelint-config-recess-order": "catalog:style",
    "stylelint-config-standard": "catalog:style",
    "tailwindcss": "catalog:frontend",
    "typescript": "catalog:tooling",
    "vite": "catalog:tooling",
    "vite-plus": "catalog:tooling",
    "vue": "catalog:frontend",
    "vue-tsc": "~3.3.11"
  },
  "packageManager": "pnpm@12.9.0"
}
