{
  "name": "engineering-automation-platform-frontend",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "internal/*",
    "scripts/*"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "vue-tsc --build && pnpm --filter @eap/vsh typecheck",
    "check:boundaries": "vsh check-boundaries",
    "check:circular": "vsh check-circular",
    "check:architecture": "vsh check",
    "lint:tests": "vp lint scripts/vsh/__tests__ apps/web/__tests__ packages/ui/__tests__ packages/icons/__tests__ packages/runtime-client/__tests__",
    "fmt:tests": "vp fmt \"**/__tests__/**/*.ts\" --check",
    "dev": "vp dev",
    "dev:mock": "vp dev apps/web --mode mock --host 127.0.0.1",
    "dev:desktop": "pnpm --filter @eap/desktop dev",
    "build": "vp build",
    "check": "vsh check && vp check",
    "test": "vp test",
    "preview": "vp preview",
    "stylelint": "stylelint \"**/*.{css,vue}\"",
    "stylelint:fix": "stylelint \"**/*.{css,vue}\" --fix",
    "clean": "node ./scripts/clean.mjs"
  },
  "devDependencies": {
    "@eap/stylelint-config": "workspace:*",
    "@eap/tsconfig": "workspace:*",
    "@eap/vsh": "workspace:*",
    "@tailwindcss/vite": "catalog:frontend",
    "@types/node": "catalog:types",
    "@vitejs/plugin-vue": "catalog:tooling",
    "happy-dom": "^21.0.4",
    "postcss-html": "catalog:style",
    "stylelint": "catalog:style",
    "stylelint-config-recess-order": "catalog:style",
    "stylelint-config-standard": "catalog:style",
    "tailwindcss": "catalog:frontend",
    "typescript": "catalog:tooling",
    "vite": "catalog:tooling",
    "vite-plus": "catalog:tooling",
    "vue": "catalog:frontend",
    "vue-tsc": "~3.3.13"
  },
  "packageManager": "pnpm@12.9.0"
}
