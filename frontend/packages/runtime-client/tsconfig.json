{
  "extends": "@eap/tsconfig/base.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "composite": true,
    "allowImportingTsExtensions": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.types",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../request"
    }
  ]
}
