{
  "stylelint.enable": true,
  "stylelint.configFile": "${workspaceFolder}/frontend/stylelint.config.mjs",
  "stylelint.cwd": "${workspaceFolder}/frontend",
  "stylelint.validate": [
    "css",
    "vue",
    "postcss"
  ],
  "css.validate": false,
  "scss.validate": false,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.vscode/**": true,
    "**/node_modules/**": true,
    "**/tmp/**": true,
    "**/bower_components/**": true,
    "**/dist/**": true,
    "**/yarn.lock": true
  },
}